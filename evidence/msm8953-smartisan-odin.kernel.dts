				clock-names = "iface", "bus", "core", "vsync";
				iommus = <0x22 0x15>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0x23>;
							phandle = <0x29>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							remote-endpoint = <0x24>;
							phandle = <0x31>;
						};
					};
				};
			};

			dsi@1a94000 {
				compatible = "qcom,msm8953-dsi-ctrl", "qcom,mdss-dsi-ctrl";
				reg = <0x1a94000 0x400>;
				reg-names = "dsi_ctrl";
				interrupt-parent = <0x21>;
				interrupts = <0x04>;
				assigned-clocks = <0x0d 0x17 0x0d 0xc0>;
				assigned-clock-parents = <0x1d 0x00 0x1d 0x01>;
				clocks = <0x0d 0x87 0x0d 0x81 0x0d 0x82 0x0d 0x83 0x0d 0x88 0x0d 0x85>;
				clock-names = "mdp_core", "iface", "bus", "byte", "pixel", "core";
