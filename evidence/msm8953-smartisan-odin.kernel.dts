				#clock-cells = <0x01>;
				#phy-cells = <0x00>;
				clocks = <0x0d 0x81 0x1b 0x00>;
				clock-names = "iface", "ref";
				status = "okay";
				vcca-supply = <0x17>;
				phandle = <0x1d>;
			};

