				assigned-clocks = <0x0d 0x18 0x0d 0xc1>;
				assigned-clock-parents = <0x1e 0x00 0x1e 0x01>;
				clocks = <0x0d 0x87 0x0d 0x81 0x0d 0x82 0x0d 0x84 0x0d 0x89 0x0d 0x86>;
				clock-names = "mdp_core", "iface", "bus", "byte", "pixel", "core";
				phys = <0x1e>;
				status = "disabled";

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0x31>;
							phandle = <0x24>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
						};
					};
				};
			};

			phy@1a96400 {
				compatible = "qcom,dsi-phy-14nm-8953";
				reg = <0x1a96400 0x100 0x1a96500 0x300 0x1a96800 0x188>;
