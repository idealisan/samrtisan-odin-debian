				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "okay";
				vdda-supply = <0x12>;
				pinctrl-names = "default", "sleep";
				pinctrl-0 = <0x25 0x26>;
				pinctrl-1 = <0x27 0x28>;

				ports {
					#address-cells = <0x01>;
					#size-cells = <0x00>;

					port@0 {
						reg = <0x00>;

						endpoint {
							remote-endpoint = <0x29>;
							phandle = <0x23>;
						};
					};

					port@1 {
						reg = <0x01>;

						endpoint {
							data-lanes = <0x00 0x01 0x02 0x03>;
							remote-endpoint = <0x2a>;
							phandle = <0x30>;
						};
					};
				};

				panel@0 {
					compatible = "smartisan,odin-panel";
					reg = <0x00>;
					backlight = <0x2b>;
					reset-gpios = <0x1a 0x3d 0x01>;
					vddio-supply = <0x2c>;
					vdd-supply = <0x2d>;
					lab-supply = <0x2e>;
					ibb-supply = <0x2f>;

					port {

						endpoint {
							remote-endpoint = <0x30>;
							phandle = <0x2a>;
						};
					};
				};
			};

