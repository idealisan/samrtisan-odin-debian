			interconnect-names = "mdp0-mem", "cpu-cfg";
			clocks = <0x0d 0x81 0x0d 0x82 0x0d 0x8a 0x0d 0x87>;
			clock-names = "iface", "bus", "vsync", "core";
			resets = <0x0d 0x06>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;
			status = "okay";
			phandle = <0x21>;

			display-controller@1a01000 {
				compatible = "qcom,msm8953-mdp5", "qcom,mdp5";
