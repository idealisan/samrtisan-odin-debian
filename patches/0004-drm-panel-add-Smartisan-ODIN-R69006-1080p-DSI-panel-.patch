From c5981699769e0ee63528693eff90454a0b3823a6 Mon Sep 17 00:00:00 2001
From: odin-port <odin@port.local>
Date: Sat, 22 Aug 2026 00:08:17 +0800
Subject: [PATCH 4/7] drm/panel: add Smartisan ODIN R69006 1080p DSI panel
 driver

Add support for the R69006-based 1080x1920 panels found in the
Smartisan ODIN, in both command mode (stock preferred panel) and
video mode variants. Initialization sequences are taken verbatim
from the stock (downstream) device tree.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
drivers/gpu/drm/panel/Kconfig        |  30 +++
 drivers/gpu/drm/panel/Makefile       |   3 +
 drivers/gpu/drm/panel/panel-r69006.c | 503 +++++++++++++++++++++++++++++++++++
 3 files changed, 536 insertions(+)

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index 8f12380de..8310eb690 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1219,3 +1219,33 @@ config DRM_PANEL_XINPENG_XPP055C272
 	  system interfaces.
 source "drivers/gpu/drm/panel/msm8953-generated/Kconfig"
 endmenu
+
+config DRM_PANEL_SMARTISAN_R69006
+	tristate "Smartisan ODIN R69006-based 1080p MIPI-DSI panels"
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	help
+	  Say Y here if you want to enable support for the R69006-based
+	  1080x1920 command and video mode DSI panels found in the Smartisan
+	  ODIN (U2 Pro) smartphone.
+
+config DRM_PANEL_SMARTISAN_FT8716
+	tristate "Smartisan ODIN FocalTech FT8716-based 1080p MIPI-DSI panels"
