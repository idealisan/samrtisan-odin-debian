+static struct mipi_dsi_driver r69006_driver = {
+	.probe = r69006_probe,
+	.remove = r69006_remove,
+	.driver = {
+		.name = "r69006",
+		.of_match_table = r69006_of_match,
+	},
+};
+module_mipi_dsi_driver(r69006_driver);
