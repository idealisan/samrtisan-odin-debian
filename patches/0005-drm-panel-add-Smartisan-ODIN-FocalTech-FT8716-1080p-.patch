+static struct mipi_dsi_driver ft8716_driver = {
+	.probe = ft8716_probe,
+	.remove = ft8716_remove,
+	.driver = {
+		.name = "ft8716",
+		.of_match_table = ft8716_of_match,
+	},
+};
