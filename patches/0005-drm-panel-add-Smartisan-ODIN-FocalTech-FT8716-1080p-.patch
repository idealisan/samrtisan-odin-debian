+	.mode_flags = MIPI_DSI_MODE_VIDEO|MIPI_DSI_MODE_VIDEO_BURST|MIPI_DSI_MODE_VIDEO_HSE|MIPI_DSI_MODE_NO_EOT_PACKET|MIPI_DSI_CLOCK_NON_CONTINUOUS,
+};
