+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Smartisan U2 Pro (ODIN), based on Qualcomm MSM8953.
+ *
+ * Panel auto-selection follows the lk2nd convention: the placeholder
+ * compatible below is replaced at boot by lk2nd with the compatible of
+ * the subnode matching the panel detected by the bootloader.
+ */
+
+/dts-v1/;
+
+#include "msm8953.dtsi"
+#include "pm8953.dtsi"
+#include "pmi8950.dtsi"
+
+/ {
+	model = "Smartisan U2 Pro (ODIN)";
+	compatible = "smartisan,odin", "qcom,msm8953";
+	chassis-type = "handset";
+	qcom,msm-id = <293 0>;
+	qcom,board-id = <0x0b 0x01>;
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-names = "default";
+		pinctrl-0 = <&gpio_key_default>;
+
+		key-volume-up {
+			label = "volume_up";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&tlmm 85 GPIO_ACTIVE_LOW>;
+		};
+	};
+
+	reserved-memory {
+		other_ext_mem: other-ext@84a00000 {
+			reg = <0x0 0x84a00000 0x0 0x1e00000>;
+			no-map;
+		};
+
+		ramoops@9ff00000 {
+			compatible = "ramoops";
+			reg = <0x0 0x9ff00000 0x0 0x100000>;
+			record-size = <0x1000>;
+			console-size = <0x80000>;
+			ftrace-size = <0x1000>;
+			pmsg-size = <0x8000>;
+		};
+	};
+
+	vph_pwr: vph-pwr-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vph_pwr";
+		regulator-always-on;
+		regulator-boot-on;
+	};
+};
+
+&hsusb_phy {
+	vdd-supply = <&pm8953_l3>;
+	vdda-pll-supply = <&pm8953_l7>;
+	vdda-phy-dpdm-supply = <&pm8953_l13>;
+
+	status = "okay";
+};
+
+&mdss {
+	status = "okay";
+};
+
+&mdss_dsi0 {
+	vdda-supply = <&pm8953_s3>;
+
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&mdss_dsi_active &mdss_te_default>;
+	pinctrl-1 = <&mdss_dsi_suspend &mdss_te_suspend>;
+
+	status = "okay";
+
+	/*
+	 * The actual panel compatible is replaced at boot by lk2nd with
+	 * the compatible of the panel detected by the bootloader. This
+	 * placeholder must match the first compatible of the "lk2nd,panel"
+	 * node in the lk2nd device description ("smartisan,odin-panel").
+	 */
+	panel@0 {
+		compatible = "smartisan,odin-panel";
+		reg = <0>;
+
+		backlight = <&pmi8950_wled>;
+		reset-gpios = <&tlmm 61 GPIO_ACTIVE_LOW>;
+
+		vddio-supply = <&pm8953_l6>;
+		vdd-supply = <&pm8953_l17>;
+		lab-supply = <&lab>;
+		ibb-supply = <&ibb>;
+
+		port {
+			panel_in: endpoint {
+				remote-endpoint = <&mdss_dsi0_out>;
+			};
+		};
+	};
+};
+
+&mdss_dsi0_out {
+	data-lanes = <0 1 2 3>;
+	remote-endpoint = <&panel_in>;
+};
+
+&mdss_dsi0_phy {
+	vcca-supply = <&pm8953_l3>;
+	status = "okay";
+};
+
+&pm8953_resin {
+	linux,code = <KEY_VOLUMEDOWN>;
+	status = "okay";
+};
+
+&pmi8950_wled {
+	/*
+	 * 2026-08-29 实机修正：原配置带 qcom,external-pfet + qcom,cabc，导致
+	 * qcom,wled probe 返回 -22(EINVAL)：
+	 *   qcom,wled 200f000.spmi:pmic@3:leds@d800: probe ... failed with error -22
+	 * 背光设备创建失败 ⇒ panel@0 的 backlight 拿不到 ⇒ 整条显示链路断掉（无 /dev/dri）。
+	 * 现对齐真机已验证可用的 markw 配置（只有下面三项，实测出 backlight 正常）。
+	 */
+	/*
+	 * 取值必须落在 drivers/video/backlight/qcom-wled.c 的值表内，否则 probe
+	 * 直接 -EINVAL ⇒ 背光设备创建失败 ⇒ panel@0 拿不到 backlight ⇒ 整条
+	 * 显示链路断（无 /dev/dri、黑屏）。
+	 *
+	 * 2026-09-01 修正：换基线后这个值被翻回了 29500。
+	 *   qcom-wled.c:1465 规定 `qcom,pmi8950-wled` 走的是 **pmi8994 那套**配置，
+	 *   不是 WLED4 那套 —— 两张表的 ovp 值不同：
+	 *     wled4_ovp_values[]        = { 31100, 29600, 19600, 18100 }
+	 *     pmi8994_wled_ovp_values[] = { 31000, 29500, 19400, 17800 }  ← 本机型用这张
+	 *   本项目历史上先写 29500（被当时那张表拒）改成 29600；换基线后映射切到
+	 *   pmi8994 表，29600 又被拒，真机报错就是
+	 *     qcom,wled 200f000.spmi:pmic@3:leds@d800: invalid value for 'qcom,ovp-millivolt'
+	 *     qcom,wled ... probe with driver qcom,wled failed with error -22
+	 *   ⇒ 背光起不来 ⇒ DSI 在 devices_deferred 里一直等背光 ⇒ msm_drm 不绑定。
+	 *   注意：pmic@3 本身是启用的（pmi8950.dtsi 里没写 status），别往那边查。
+	 *
+	 *   qcom,current-limit-microamp 合法表 = { 0, 2500, ... 20000 ... 30000 }
+	 *   qcom,num-strings             合法范围 = 1 .. max_string_count(4)
+	 */
+	qcom,current-limit-microamp = <20000>;
+	qcom,ovp-millivolt = <29500>;
+	qcom,num-strings = <2>;
+
+	label = "backlight";
+	default-brightness = <2048>;   /* 50%：之前写 200 只有 5%，屏幕看起来像没开背光 */
+
+	status = "okay";
+};
+
+&rpm_requests {
+	regulators {
+		compatible = "qcom,rpm-pm8953-regulators";
+		vdd_s1-supply = <&vph_pwr>;
+		vdd_s2-supply = <&vph_pwr>;
+		vdd_s3-supply = <&vph_pwr>;
+		vdd_s4-supply = <&vph_pwr>;
+		vdd_s5-supply = <&vph_pwr>;
+		vdd_s6-supply = <&vph_pwr>;
+		vdd_s7-supply = <&vph_pwr>;
+		vdd_l1-supply = <&pm8953_s3>;
+		vdd_l2_l3-supply = <&pm8953_s3>;
+		vdd_l4_l5_l6_l7_l16_l19-supply = <&pm8953_s4>;
+		vdd_l8_l11_l12_l13_l14_l15-supply = <&vph_pwr>;
+		vdd_l9_l10_l17_l18_l22-supply = <&vph_pwr>;
+
+		pm8953_s1: s1 {
+			regulator-min-microvolt = <870000>;
+			regulator-max-microvolt = <1156000>;
+		};
+
+		pm8953_s3: s3 {
+			regulator-min-microvolt = <984000>;
+			regulator-max-microvolt = <1224000>;
+		};
+
+		pm8953_s4: s4 {
+			regulator-min-microvolt = <1900000>;
+			regulator-max-microvolt = <2050000>;
+		};
+
+		pm8953_l1: l1 {
+			regulator-min-microvolt = <1000000>;
+			regulator-max-microvolt = <1100000>;
+		};
+
+		pm8953_l2: l2 {
+			regulator-min-microvolt = <1200000>;
+			regulator-max-microvolt = <1225000>;
+		};
+
+		pm8953_l3: l3 {
+			regulator-min-microvolt = <925000>;
+			regulator-max-microvolt = <925000>;
+		};
+
+		pm8953_l5: l5 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		pm8953_l6: l6 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		pm8953_l7: l7 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1900000>;
+		};
+
+		pm8953_l8: l8 {
+			regulator-min-microvolt = <2900000>;
+			regulator-max-microvolt = <2900000>;
+		};
+
+		pm8953_l9: l9 {
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3300000>;
+		};
+
+		pm8953_l10: l10 {
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
+		};
+
+		pm8953_l11: l11 {
+			regulator-min-microvolt = <2950000>;
+			regulator-max-microvolt = <2950000>;
+		};
+
+		pm8953_l12: l12 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <2950000>;
+		};
+
+		pm8953_l13: l13 {
+			regulator-min-microvolt = <3125000>;
+			regulator-max-microvolt = <3125000>;
+		};
+
+		pm8953_l16: l16 {
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		pm8953_l17: l17 {
+			regulator-min-microvolt = <2850000>;
