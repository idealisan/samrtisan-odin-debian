+
+&sdhc_1 {
+	vmmc-supply = <&pm8953_l8>;
+	vqmmc-supply = <&pm8953_l5>;
+
+	status = "okay";
+};
+
+&sdhc_2 {
+	vmmc-supply = <&pm8953_l11>;
+	vqmmc-supply = <&pm8953_l12>;
+
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&sdc2_clk_on &sdc2_cmd_on &sdc2_data_on &sdc2_cd_on>;
+	pinctrl-1 = <&sdc2_clk_off &sdc2_cmd_off &sdc2_data_off &sdc2_cd_off>;
+
+	status = "okay";
+};
+
+&tlmm {
+	gpio-reserved-ranges = <0 4>, <16 4>, <135 4>;
+
+	gpio_key_default: gpio-key-default-state {
+		pins = "gpio85";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+	};
+
+	mdss_dsi_active: mdss-dsi-active-state {
+		pins = "gpio61";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	mdss_dsi_suspend: mdss-dsi-suspend-state {
+		pins = "gpio61";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	mdss_te_default: mdss-te-default-state {
+		pins = "gpio24";
+		function = "mdp_vsync";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	mdss_te_suspend: mdss-te-suspend-state {
+		pins = "gpio24";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+
+	ts_int_active: ts-int-active-state {
+		pins = "gpio65";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	ts_int_suspend: ts-int-suspend-state {
+		pins = "gpio65";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+
+	ts_reset_active: ts-reset-active-state {
+		pins = "gpio64";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	ts_reset_suspend: ts-reset-suspend-state {
+		pins = "gpio64";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-down;
+	};
+};
+
+/* ---------------------------------------------------------------- 触摸屏
+ *
+ * ODIN 的触摸芯片是 **FocalTech FT8716**，与显示驱动集成在同一颗 TDDI 上
+ * （patches/0005 的标题就是 "FocalTech FT8716 TDDI-based 1080x1920"）。
+ * 硬件参数全部取自原厂安卓包的反编译设备树
+ * evidence/stock-rom-battery/odin-stock.dts:6367 的 focaltech@38：
+ *   i2c@78b7000（主线 &i2c_3，BLSP1 QUP3）地址 0x38，
+ *   reset gpio64 / irq gpio65，vcc_i2c 由 pm8953_l6(1.8V) 供；
+ *   pinctrl 的驱动强度与上下拉逐项对齐原厂 :1808-1895
+ *   （也和主线 msm8953-xiaomi-common.dtsi:382-431 一致）。
+ *
+ * 驱动用主线的 `edt-ft5x06`（drivers/input/touchscreen/edt-ft5x06.c:1530
+ * 有 `focaltech,ft8716`），CONFIG_TOUCHSCREEN_EDT_FT5X06 已经是 =m，
+ * **不需要动内核配置，也不需要固件**。
+ * compatible 写两个：先试精确型号，退回到 edt-ft5406 的通用行为。
+ *
+ * 2026-09-01 真机验证：/dev/input/event3 注册为 "generic ft5x06 (8d)"，
+ * 划屏能读到 ABS_MT_POSITION_X/Y 与 BTN_TOUCH，坐标在 1080x1920 内。
+ *
+ * 两点要注意：
+ *   1) 这颗 TDDI **要有面板先上电才响应**。背光（&pmi8950_wled）一旦
+ *      probe 失败，DSI 会一直等它，触摸也就跟着 probe 超时失败
+ *      —— 所以"触摸 probe failed"有时是显示那边的锅，别只盯着触摸。
+ *   2) 换屏（NT36672 等）时触摸芯片也跟着换，那要另配节点；本文件目前
+ *      写死 FT8716 一套（与 extlinux.conf 里面板写死的做法一致）。
+ */
+&i2c_3 {
+	status = "okay";
+
+	touchscreen@38 {
+		compatible = "focaltech,ft8716", "edt,edt-ft5406";
+		reg = <0x38>;
+
+		interrupt-parent = <&tlmm>;
+		interrupts = <65 IRQ_TYPE_EDGE_FALLING>;
+
+		pinctrl-names = "default", "sleep";
+		pinctrl-0 = <&ts_int_active &ts_reset_active>;
+		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
+
+		reset-gpios = <&tlmm 64 GPIO_ACTIVE_LOW>;
+		iovcc-supply = <&pm8953_l6>;
+
+		touchscreen-size-x = <1080>;
+		touchscreen-size-y = <1920>;
+	};
+};
+
+&uart_0 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart_console_active>;
+
+	status = "okay";
+};
+
+&usb3 {
+	status = "okay";
+	dr_mode = "otg";
+};
+
+&gpu {
+	/*
+	 * 2026-08-29 实机补漏：msm8953.dtsi 里 gpu@1c00000 默认 status="disabled"，
+	 * 而本文件此前完全没有启用它 ⇒ 实机 "msm_mdp: no GPU device was found"、
+	 * GPU 设备不存在、无 /dev/kgsl*。对比 markw 的 DTB 是有完整 gpu 节点的。
+	 * 启用 GPU 后 msm_drm 的显示管线才完整（面板 DSI 命令 -EINVAL 的嫌疑对象）。
+	 *
+	 * zap-shader 的 memory-region 由 msm8953.dtsi 的 gpu_zap_shader 提供；
+	 * a506_zap.mdt 是 postmarketOS 专有固件（从原厂 ROM 提取），Debian 与容器中都没有，
+	 * 缺它时 GPU 仍可初始化，只是没有 zap 安全内容保护，等取到固件后再补 firmware-name。
+	 */
+	status = "okay";
+};
+
+/*
+ * WiFi（WCNSS / pronto）—— 2026-08-30 实机补漏
+ *
+ * msm8953.dtsi 里 wcnss: remoteproc@a204000 默认 status="disabled"，本文件此前
+ * 也没启用它 ⇒ 实机上根本没有 wlan0，NetworkManager 里只有 lo 和 usb0。
+ *
+ * 配置照抄自能正常用 WiFi 的 markw（小米 Redmi 4 Prime）的 DTB：
+ *   iris compatible = "qcom,wcn3660b"
+ *   vddxo→l7  vddrfa→l19  vddpa→l9  vdddig→l5  vddpx→l5
+ * 这几个 LDO 在本文件里的电压范围（l5 1.8V、l7 1.8~1.9V、l9 3.0~3.3V、
+ * l19 1.2~1.38V）与 markw 一致，也与原厂 DTB 声明的
+ * iris-vddxo/rfa/pa/dig = 1.8V / 1.3V / 3.3V / 1.8V 对得上。
+ *
+ * 还需要的用户态文件（不在 DTB 里，见 dist/build/rootfs 的说明）：
+ *   /lib/firmware/wlan/prima/WCNSS_qcom_wlan_nv.bin   板级校准数据
+ *   来源：persist 分区（mmcblk0p24，原厂未动过）里的 WCNSS_qcom_wlan_nv.bin，
+ *   由 odin-wlan-nv.service 首启拷过去。
+ */
+&wcnss {
+	status = "okay";
+	vddpx-supply = <&pm8953_l5>;
+};
+
+&wcnss_iris {
+	compatible = "qcom,wcn3660b";
+	vddxo-supply = <&pm8953_l7>;
+	vddrfa-supply = <&pm8953_l19>;
+	vddpa-supply = <&pm8953_l9>;
+	vdddig-supply = <&pm8953_l5>;
+	status = "okay";
+};
+
+/*
+ * 音频 —— 2026-09-03 启用
+ *
+ * 主线 msm8953 的音频不是"驱动直接喂 codec"，而是整条链路跑在 **ADSP**
+ * （Hexagon 音频 DSP）上，AP 侧通过 APR 与它通信：
+ *
+ *   &lpass      remoteproc，加载 adsp.mdt 把 ADSP 拉起来
+ *               （msm8953.dtsi:3076，compatible = "qcom,msm8953-adsp-pil"）
+ *   q6afe/q6adm/q6asm/q6routing  ADSP 上的服务（在 lpass 之下，无需在 DTS 里写）
+ *   &lpass_codec  数字部分 qcom,msm8916-wcd-digital-codec（msm8953.dtsi:3065）
+ *   &wcd_codec    模拟部分 qcom,pm8916-wcd-analog-codec，在 **pm8953.dtsi:141**
+ *                 （PMIC 里的 codec，注意它在 pm8953.dtsi 而不是 msm8953.dtsi）
+ *   &sound_card   machine driver qcom,msm8953-qdsp6-sndcard（msm8953.dtsi:2982）
+ *                 内含 Primary MI2S（回放）与 Tertiary MI2S（录音）两条 dai-link，
+ *                 每条的 codec 侧都是 <lpass_codec N>, <wcd_codec N>。
+ *
+ * 三者都必须显式 status = "okay" —— 主线 dtsi 里它们默认全是 disabled。
+ * 实测：只写其中一部分的话 /proc/asound/cards 就是 "--- no soundcards ---"。
+ *
+ * ⚠️ ADSP 固件 adsp.mdt + adsp.b00~b13 不在任何 Debian 包里，取自原厂
+ *    modem 分区的 /image/（与 wcnss.*、venus.* 同级），由 initramfs 的
+ *    odin-adsp-fw.sh 在 switch_root 之前备好。
+ *    关键点：qcom,msm8953-adsp-pil 的匹配数据 msm8996_adsp_resource 带
+ *    **auto_boot = true** —— 驱动一 probe 就立刻 request_firmware，
+ *    失败不会自己重试，之后补文件也没用。固件必须先于驱动就位。
+ *
+ * 本机是 **两个麦克风 + 一个扬声器 + 一个听筒**（用户 2026-09-03 确认），
+ * 不是立体声双扬声器。默认 audio-routing 已覆盖 AMIC1/AMIC2/AMIC3
+ * （分别挂在 MIC BIAS External1/2/1），先不动它。
+ *
+ * ⚠️ 尚未接的部分：外置扬声器功放。pmOS 的 mido（红米 Note 4）用的是
+ *    awinic,aw8738 + tlmm 96，但那是对照抄过来的猜测，本机 GPIO 是否相同
+ *    没有证据。09-01 那轮实验在 RX3（听筒通路）上有数据、有增益、零报错
+ *    但物理不发声 —— 说明问题很可能就在这颗功放没打开。等音频基础链路
+ *    起来后，用 amixer 逐个试 SPK 通路与 GPIO，再补这一节。
+ */
+/*
+ * USB Type-C 控制器：FUSB301 —— 2026-09-03
+ *
+ * 依据官方开源内核（SmartisanOS_Kernel_Source 的 U2ProKernel 分支）
+ * `arch/arm/boot/dts/qcom/u3-p1-msm8953-charging.dtsi`：
+ *
+ *     &i2c_6 {
+ *         fusb301@25 {
+ *             compatible = "fc,fusb301";
+ *             reg = <0x25>;
+ *             fusb301,int-gpio = <&tlmm 38 0>;      ← 中断在 GPIO 38
+ *             fusb301,init-mode = /bits/ 8 <0x20>;  ← DRP + 音频配件检测
+ *             fusb301,host-current = /bits/ 8 <1>;
+ *             fusb301,use-try-snk-emulation;
+ *             qcom,usb_switch_asel = <&tlmm 33 0>;  ← USB 通路开关选择脚
+ *             qcom,cdc_hsdet_l    = <&tlmm 25 0>;   ← 耳机检测（音频用）
+ *         };
+ *     };
+ *
+ * ⚠️ 这条推翻了 fc3e971 的判断。那一版把 FUSB301 的补丁当成"用不到"删掉了
+ *    （连同 SMBCHG OTG boost 一起删了 665 行）。官方源码证明 **这颗芯片焊在板子上**：
+ *    它在 i2c_6 的 0x25 地址、中断接 GPIO 38，而且管着 USB 通路开关（GPIO 33）。
+ *
+ * 主线侧怎么接：
+ *   - 驱动是主线自带的 `drivers/usb/typec/fusb301.c`（compatible = "fcs,fusb301"，
+ *     注意是 fcs 不是下游的 fc）。需要 CONFIG_TYPEC_FUSB301（已加到内核配置）。
+ *   - 总线的对应是干净的：下游 `i2c_6: i2c@7af6000`，主线 `i2c_6: i2c@7af6000`
+ *     —— 编号和地址都一样，可以直接照搬地址 0x25。
+ *   - 驱动的 probe 会读 `device_get_named_child_node(dev, "connector")`，
+ *     所以必须有 `connector` 子节点；connector 上带 `usb-role-switch`，
+ *     并用 port/endpoint 指回 dwc3 的 `usb_dwc3_hs`（主线 msm8953.dtsi:2312
+ *     留了个空 endpoint 就是给板级填 remote-endpoint 用的）。
+ *   - `fcs,init-mode` / `fcs,host-current` 照抄下游的 0x20 / 1。
+ *   - 下游那两个 `qcom,usb_switch_asel`（GPIO 33）、`qcom,cdc_hsdet_l`（GPIO 25）
+ *     是下游驱动私有的，主线没有对应，这里不建模。GPIO 33 是**物理的 USB 通路
+ *     开关选择脚** —— 如果实测发现 OTG 仍然不通（比如 VBUS 出了但数据不通），
+ *     第一嫌疑就是这根脚没人拉，需要再加一个 gpio-hog 或 fixed-regulator 去控。
+ *
+ * ⚠️ 待真机验证：FUSB301 与 pmi8950_smbcharger 都可能提供角色切换，需要确认
+ *    最终生效的是哪一个。若角色切换异常，先试把 connector 上的 `usb-role-switch`
+ *    去掉（保留 smbchg → usb3 那条），看是否恢复。
+ */
+&i2c_6 {
+	status = "okay";
+
+	fusb301@25 {
+		compatible = "fcs,fusb301";
+		reg = <0x25>;
+		interrupt-parent = <&tlmm>;
+		interrupts = <38 IRQ_TYPE_LEVEL_LOW>;
+		fcs,init-mode = <0x20>;
+		fcs,host-current = <1>;
+
+		/*
+		 * 这里**故意不接** connector → dwc3 的 port/endpoint。
+		 * 原因：本文件是共享基础 DTS，`msm8953-smartisan-odin-norolesw.dts`
+		 * 会对 `&usb3` 做 `/delete-node/ ports;`（那是安全版的既定取舍 ——
+		 * 不做角色切换），于是 `usb_dwc3_hs` 那个 endpoint 在安全版里不存在。
+		 * 若在基础 DTS 里写 `&usb_dwc3_hs { remote-endpoint = <&usb_con_hs>; }`，
+		 * 安全版会直接编不过（ERROR: Reference to non-existent node or label
+		 * "usb_dwc3_hs"）—— 已实测复现。
+		 *
+		 * 所以角色切换仍由 `pmi8950_smbcharger { usb-role-switch = <&usb3>; }`
+		 * 那条提供（完整版 l0 生效，安全版 l0-safe 不生效），本节点只负责
+		 * 让 FUSB301 起来、把 CC / 方向检测暴露出来。等真机确认角色切换最终
+		 * 由谁驱动之后，再决定要不要把 endpoint 接回去（接的话要写到完整版
+		 * 专用的 DTS 里，不能放共享基础）。
+		 */
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C";
+		};
+	};
+};
+
+&lpass {
+	status = "okay";
+};
+
+/*
+ * 麦克风偏置 —— 官方 `u3-p1-msm8953-special-odin-audio.dtsi` 给的：
+ *     &pm8953_diangu_dig { qcom,cdc-micbias-cfilt-mv = <2700000>; }   即 2.7V
+ *     &int_codec        { qcom,msm-micbias2-ext-cap; ... }
+ *
+ * 主线 `sound/soc/codecs/msm8916-wcd-analog.c` 认的属性名不同，要换算：
+ *     qcom,cdc-micbias-cfilt-mv (uV)  →  qcom,micbias-lvl (mV)：2700000 uV = 2700
+ *     qcom,msm-micbias2-ext-cap       →  qcom,micbias2-ext-cap
+ * 都写在 &wcd_codec 上（它的 compatible 是 qcom,pm8916-wcd-analog-codec，
+ * 驱动就是 msm8916-wcd-analog.c）。见
+ * Documentation/devicetree/bindings/sound/qcom,pm8916-wcd-analog-codec.yaml。
+ *
+ * 另外几条官方参数主线没有对应，不建模：
+ *   - qcom,msm-hs-micbias-type = "external"：主线的 micbias 供电由
+ *     MIC BIAS External1/2 在 audio-routing 里表达，没有这个属性。
+ *   - qcom,msm-mbhc-hphl-swh / qcom,cdc-us-euro-gpios（GPIO 128，US/EURO
+ *     耳机检测）：主线没有 us-euro 切换。主线有
+ *     qcom,hphl-jack-type-normally-open 与 qcom,gnd-jack-type-normally-open，
+ *     但**极性没有官方依据**，不乱猜 —— 等实测耳机插拔行为再定。
+ *   - 官方 &int_codec 那一大组 pinctrl（cdc_pdm_lines_*）：**更正 09-03 的判断** ——
+ *     主线有同名的三组状态，就定义在 msm8953.dtsi 的 &tlmm 里
+ *     （gpio67~74，function = "cdc_pdm0"），而且**必须配**；
+ *     配置位置见下面 &sound_card 的 pinctrl-0 / pinctrl-1。
+ */
+&wcd_codec {
+	status = "okay";
+	qcom,micbias2-ext-cap;
+	qcom,micbias-lvl = <2700>;
+};
+
+/*
+ * 外置扬声器功放 + 听筒 —— 2026-09-03
+ *
+ * 依据来自**官方开源内核**（SmartisanOS_Kernel_Source 的 U2ProKernel 分支，
+ * Linux 3.18）里的 `arch/arm/boot/dts/qcom/u3-p1-msm8953-special-odin-audio.dtsi`：
+ *
+ *     &pm8953_diangu_dig {
+ *         status = "ok";
+ *         qcom,cdc-micbias-cfilt-mv = <2700000>;
+ *         qcom,ext-pa-enable = <&tlmm 132  0>;   ← 外置功放使能 = GPIO 132
+ *         qcom,speaker-id    = <&tlmm 93   0>;   ← 扬声器 ID 检测（输入，主线不需要）
+ *     };
+ *     &int_codec { status = "ok"; ... };          ← 用的就是 PMIC 内置 codec
+ *
+ * ⚠️ 关键更正（2026-09-04，听筒与麦克风都已出声、只剩扬声器不响之后查到的）：
+ *    那颗功放是 **AW87318 一类的 Awinic 功放**，而且**不是拉高就开** ——
+ *    它靠 MODE 脚上的**脉冲个数**选工作模式。原厂 msm8x16-wcd.c 第 5015 行：
+ *
+ *        （上一行是原厂注释 "lineout to AW87318"）
+ *        {"AW_SPK_PA", NULL, "LINEOUT PA"},          ← 音频来自 LINEOUT，不是 SPK_OUT
+ *        SND_SOC_DAPM_SPK("AW_SPK_PA", aw_speaker_pa_enable),
+ *
+ *        static int aw_speaker_pa_enable(...)
+ *        {
+ *            case SND_SOC_DAPM_POST_PMU:
+ *                gpio_set_value(ext_pa_en_gpio, 1);          ← 第 1 个上升沿
+ *                for (i = 0; i < mode; i++) {                ← mode = 5
+ *                    gpio_set_value(ext_pa_en_gpio, 0);
+ *                    gpio_set_value(ext_pa_en_gpio, 1);      ← 再来 5 个
+ *                }
+ *        }
+ *        #  define AW_BOOST_DEFAULT_MODE 6
+ *        #  static int aw_boost_mode = AW_BOOST_DEFAULT_MODE - 1;   即 5
+ *
+ *    加起来 **6 个上升沿**。
+ *
+ * 三个要点：
+ *   1. 用主线自带的 `awinic,aw8738`（sound/soc/codecs/aw8738.c），
+ *      它就是在 POST_PMU 里打脉冲的；`simple-audio-amplifier` 只会把脚拉高，
+ *      AW 芯片永远等不到模式脉冲 ⇒ 一直关着 ⇒ **扬声器不出声**。
+ *      这就解释了"DAPM 全 On、GPIO 132 也确实是 high、可就是没声"。
+ *   2. `awinic,mode = <6>`：上游驱动从 low 起打 `mode` 个 (0,1)，
+ *      要凑出下游那 1 + 5 = 6 个上升沿，这里就得写 6。
+ *   3. **音频输入是 LINEOUT，不是 SPK_OUT**。主线对应
+ *        {"LINEOUT_OUT", NULL, "LINEOUT PA"}
+ *        {"LINEOUT PA",  NULL, "LINEOUT"}
+ *        {"LINEOUT", "Switch", "LINEOUT DAC"}
+ *        {"LINEOUT DAC", NULL, "PDM_RX3"}
+ *      所以 routing 写 `"Speaker Amp INL", "LINEOUT_OUT"`，
+ *      运行时还要把 `LINEOUT` 这个 mux 打到 Switch（UCM 里做）。
+ *
+ * 顺带排掉一条：codec 里另一个功放 widget
+ *        SND_SOC_DAPM_SPK("Ext Spk", msm8x16_wcd_codec_enable_spk_ext_pa)
+ *  走的是**电平**驱动，GPIO 由 `qcom,msm-spk-ext-pa` 指定 ——
+ *  整个原厂 DTS 树里**没有任何一份**定义这个属性，所以那条路对 ODIN 是死代码。
+ *
+ * 拓扑：WCD 的 LINEOUT_OUT → 功放 INL → DRV(GPIO132 打 6 个脉冲) → Ext Spk
+ *
+ * 另外不建模 `qcom,speaker-id`（GPIO 93）—— 那是给安卓 HAL 选功放型号用的
+ * 输入引脚，主线不需要。
+ *
+ * 听筒（EAR）由 WCD 直接驱动，不经外置功放，所以走 audio-routing 直连。
+ */
+/ {
+	speaker_amp: audio-amplifier {
+		compatible = "awinic,aw8738";
+		mode-gpios = <&tlmm 132 GPIO_ACTIVE_HIGH>;
+		awinic,mode = <6>;
+		sound-name-prefix = "Speaker Amp";
+	};
+};
+
+&sound_card {
+	status = "okay";
+
+	/*
+	 * model 是**必填项**，不是可选的装饰。
+	 * sound/soc/soc-core.c 的 snd_soc_register_card() 开头就是
+	 *     if (!card->name || !card->dev)
+	 *             return -EINVAL;
+	 * 这一句**不带任何 dev_err** —— 缺了 model，整张卡静默 probe 失败，
+	 * dmesg 里只剩 driver core 那一句
+	 *     qcom-apq8016-sbc c051000.sound-card: probe ... failed with error -22
+	 * （2026-09-04 实刷 v0.9.4-submodules 撞上：ADSP 起来了、APR 设备也注册了，
+	 *   /proc/asound/cards 却仍是 "--- no soundcards ---"。）
+	 * 它同时是 ALSA 卡名，UCM 目录 conf.d/smartisan-odin 就是照它匹配的。
+	 */
+	model = "smartisan-odin";
+
+	/*
+	 * PDM 引脚复用 —— 更正 09-03 那句"主线不走这套"：**主线走，而且必须走**。
+	 * msm8953 全系板（mido / markw / potter / ysl / oxygen / vince …）都在
+	 * &sound_card 上挂这三组状态，定义在 msm8953.dtsi 的 &tlmm 里
+	 * （gpio67~74，function = "cdc_pdm0"）。不配就没有任何引脚被复用成
+	 * cdc_pdm0，WCD 的数字音频接口物理上就是断的。
+	 */
+	pinctrl-names = "default", "sleep";
+	pinctrl-0 = <&cdc_pdm_lines_act &cdc_pdm_lines_2_act &cdc_pdm_comp_lines_act>;
+	pinctrl-1 = <&cdc_pdm_lines_sus &cdc_pdm_lines_2_sus &cdc_pdm_comp_lines_sus>;
+
+	/*
+	 * widgets 的第一个字符串是**类型**，snd_soc_of_parse_audio_simple_widgets()
+	 * 只认四种：Microphone / Line / Headphone / Speaker。
+	 * 写 "Earpiece" 会直接把整个声卡的 probe 打成 -EINVAL：
+	 *     ASoC: DAPM widget 'Earpiece' is not supported
+	 *     qcom-apq8016-sbc: probe ... failed with error -22
+	 * （2026-09-04 实刷 v0.9.4-audio4 撞上，一条声卡都没出来。）
+	 * 听筒用 "Line" 类型、名字仍叫 Earpiece。
+	 *
+	 * 本机**没有 3.5mm 耳机接口**（用户确认），所以不做耳机通路，
+	 * 只保留扬声器 / 听筒 / 麦克风。
+	 */
+	widgets =
+		"Speaker", "Ext Spk",
+		"Line", "Earpiece";
+
+	audio-routing =
+		/* 麦克风（沿用 dtsi 默认：AMIC1/2/3 → MIC BIAS External1/2/1） */
+		"AMIC1", "MIC BIAS External1",
+		"AMIC2", "MIC BIAS External2",
+		"AMIC3", "MIC BIAS External1",
+		/*
+		 * 扬声器：RX3 → PDM_RX3 → LINEOUT DAC → LINEOUT(mux=Switch)
+		 *          → LINEOUT PA → LINEOUT_OUT → 外置 AW 功放 → Ext Spk
+		 *
+		 * 取 **LINEOUT_OUT** 而不是 SPK_OUT —— 原厂 msm8x16-wcd.c 白纸黑字：
+		 *     {"AW_SPK_PA", NULL, "LINEOUT PA"},   （注释：lineout to AW87318）
+		 * 且 {"LINEOUT_OUT", NULL, "LINEOUT PA"} 在主线是无 mux 的直连，
+		 * 用它可以少开一个开关。
+		 *
+		 * 端点名是 **IN / OUT**，不是 INL / OUTL！
+		 * aw8738.c 的 DAPM 只有三个部件：IN(输入) → DRV → OUT(输出)，
+		 * 和 simple-amplifier 的 INL/INR → DRV → OUTL/OUTR **不一样**。
+		 * 加上 sound-name-prefix "Speaker Amp"，实际名字就是
+		 * "Speaker Amp IN" / "Speaker Amp OUT"。
+		 * （上一版照 simple-amplifier 写了 INL/OUTL，两条路由都 ENODEV，
+		 *   整张卡注册失败 —— 已刷机验证，务必记牢。）
+		 *
+		 * 从 **OUT** 取而不是 DRV：DAPM 会顺着 OUT 反向把 DRV 带上电，
+		 * POST_PMU 才会去打那 6 个脉冲。
+		 */
+		"Speaker Amp IN", "LINEOUT_OUT",
+		"Ext Spk", "Speaker Amp OUT",
+		/* 听筒：WCD 的 EAR 直驱，不经外置功放 */
+		"Earpiece", "EAR";
+
+	/* pin-switches 会**覆盖** card->controls（丢掉驱动自带的
+	 * Headphone Jack / Mic Jack 两个开关），本机没有耳机口，正好不需要。
+	 * widget 的 connected 默认是 1，所以开机后 Ext Spk / Earpiece 直接可用。 */
+	pin-switches = "Ext Spk", "Earpiece";
+	aux-devs = <&speaker_amp>;
+};
+
+/*
+ * 电池 / 充电 / 电量计 —— 参数取自原厂安卓包里的下游设备树（reports/025）
+ *
+ * 原厂 boot.img 的 DTB 里声明了两块电池（ATL / SCUD 两家供应商，靠 ID 电阻
+ * 10kΩ / 100kΩ 区分），但标称参数完全一致：
+ *   3500 mAh    qcom,nom-batt-capacity-mah
+ *   4.400 V     qcom,max-voltage-uv / smbcharger qcom,float-voltage-mv
+ *   3.400 V     qcom,fg-cutoff-voltage-mv
+ *   100 mA      smbcharger qcom,iterm-ma
+ * 只有 NTC B 值不同（3435 / 3380），而主线用固定的 SCALE_PMI_CHG_TEMP，
+ * 故这里只填一组，不必做电池识别。
+ *
+ * constant-charge-current-max-microamp **不抄**原厂的 3500 mA —— 那是
+ * PMI8950 SMBC + SMB1351 并联充电的总能力，主线没有 smb1351 驱动，
+ * 并联不可用。先按 1500 mA 保守起步（pmOS markw 用 1000 mA），
+ * 真机测过温升与输入限流后再往上调。
+ * 注意：该属性是 qcom,smbchg 绑定的**必填项**，缺失会直接 probe 失败，
+ * 连 qcom-smbchg-usb 这个 psy 都出不来。
+ * 写法上必须包在 `/ { }` 里：**不能**写成根节点闭合之后的顶层节点 ——
+ * 容器内 dtc 1.6.1 对那种写法直接报 `syntax error`（实测最小复现已验证），
+ * 包进根覆盖块则正常合并。
+ */
+/ {
+	battery: battery {
+		compatible = "simple-battery";
+
+		charge-full-design-microamp-hours = <3500000>;
+		voltage-min-design-microvolt = <3400000>;
+		voltage-max-design-microvolt = <4400000>;
+		constant-charge-current-max-microamp = <1500000>;
+		charge-term-current-microamp = <100000>;
+	};
+};
+
+&pmi8950_fg {
+	monitored-battery = <&battery>;
+	power-supplies = <&pmi8950_smbcharger>;
+	status = "okay";
+};
+
