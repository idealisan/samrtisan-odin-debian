+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/regulator/consumer.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+
+struct nt36672 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[4];
+	bool prepared;
+	const struct odin_panel_variant *variant;
+};
+
+static inline struct nt36672 *to_nt36672(struct drm_panel *panel)
+{
+	return container_of(panel, struct nt36672, panel);
+}
+
+#define dsi_generic_write_seq(dsi, seq...) do {				\
+		static const u8 d[] = { seq };				\
+		int ret;							\
+		ret = mipi_dsi_generic_write(dsi, d, ARRAY_SIZE(d));	\
+		if (ret < 0)							\
+			return ret;						\
+	} while (0)
+
+#define dsi_dcs_write_seq(dsi, seq...) do {				\
+		static const u8 d[] = { seq };				\
+		int ret;							\
+		ret = mipi_dsi_dcs_write_buffer(dsi, d, ARRAY_SIZE(d));	\
+		if (ret < 0)							\
+			return ret;						\
+	} while (0)
+
+static void nt36672_panel_reset(struct nt36672 *ctx)
+{
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(2000, 3000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static int nt36672_panel_on(struct nt36672 *ctx)
+{
+	struct mipi_dsi_device *dsi = ctx->dsi;
+
+	dsi->mode_flags |= MIPI_DSI_MODE_LPM;
+
+	dsi_dcs_write_seq(dsi, 0xff, 0x22);
+	dsi_dcs_write_seq(dsi, 0x07, 0x6b);
+	dsi_dcs_write_seq(dsi, 0x08, 0x67);
+	dsi_dcs_write_seq(dsi, 0x0a, 0x5d);
+	dsi_dcs_write_seq(dsi, 0x0b, 0x57);
+	dsi_dcs_write_seq(dsi, 0x0c, 0x52);
+	dsi_dcs_write_seq(dsi, 0x0d, 0x4d);
+	dsi_dcs_write_seq(dsi, 0x0e, 0x48);
+	dsi_dcs_write_seq(dsi, 0x0f, 0x44);
+	dsi_dcs_write_seq(dsi, 0x17, 0x00);
+	dsi_dcs_write_seq(dsi, 0x53, 0x01);
+	dsi_dcs_write_seq(dsi, 0x54, 0x00);
+	dsi_dcs_write_seq(dsi, 0x55, 0x88);
+	dsi_dcs_write_seq(dsi, 0x56, 0x75);
+	dsi_dcs_write_seq(dsi, 0x58, 0x55);
+	dsi_dcs_write_seq(dsi, 0x59, 0x4d);
+	dsi_dcs_write_seq(dsi, 0x5a, 0x45);
+	dsi_dcs_write_seq(dsi, 0x5b, 0x45);
+	dsi_dcs_write_seq(dsi, 0x5c, 0x47);
+	dsi_dcs_write_seq(dsi, 0x5d, 0x44);
+	dsi_dcs_write_seq(dsi, 0x5e, 0x41);
+	dsi_dcs_write_seq(dsi, 0x5f, 0x40);
+	dsi_dcs_write_seq(dsi, 0x60, 0x40);
+	dsi_dcs_write_seq(dsi, 0x61, 0x40);
+	dsi_dcs_write_seq(dsi, 0x62, 0x40);
+	dsi_dcs_write_seq(dsi, 0x63, 0x40);
+	dsi_dcs_write_seq(dsi, 0x64, 0x43);
+	dsi_dcs_write_seq(dsi, 0x65, 0x47);
+	dsi_dcs_write_seq(dsi, 0x66, 0x4a);
+	dsi_dcs_write_seq(dsi, 0x67, 0x4d);
+	dsi_dcs_write_seq(dsi, 0x68, 0x50);
+	dsi_dcs_write_seq(dsi, 0x69, 0x55);
+	dsi_dcs_write_seq(dsi, 0x6a, 0x58);
+	dsi_dcs_write_seq(dsi, 0x6b, 0x55);
+	dsi_dcs_write_seq(dsi, 0x6c, 0x54);
+	dsi_dcs_write_seq(dsi, 0x6d, 0x53);
+	dsi_dcs_write_seq(dsi, 0x6e, 0x54);
+	dsi_dcs_write_seq(dsi, 0x6f, 0x55);
+	dsi_dcs_write_seq(dsi, 0x73, 0x05);
+	dsi_dcs_write_seq(dsi, 0x83, 0x03);
+	dsi_dcs_write_seq(dsi, 0x84, 0x28);
+	dsi_dcs_write_seq(dsi, 0x86, 0x40);
+	dsi_dcs_write_seq(dsi, 0x87, 0x43);
+	dsi_dcs_write_seq(dsi, 0x89, 0x20);
+	dsi_dcs_write_seq(dsi, 0x8a, 0x37);
+	dsi_dcs_write_seq(dsi, 0x97, 0xc0);
+	dsi_dcs_write_seq(dsi, 0x9a, 0x4c);
+	dsi_dcs_write_seq(dsi, 0x9b, 0x5a);
+	dsi_dcs_write_seq(dsi, 0x9c, 0x4c);
+	dsi_dcs_write_seq(dsi, 0xa2, 0x20);
+	dsi_dcs_write_seq(dsi, 0xb3, 0x00);
+	dsi_dcs_write_seq(dsi, 0xb7, 0x70);
+	dsi_dcs_write_seq(dsi, 0xb8, 0x70);
+	dsi_dcs_write_seq(dsi, 0xfb, 0x01);
+	dsi_generic_write_seq(dsi, 0xff, 0x20);
+	dsi_generic_write_seq(dsi, 0xfb, 0x01);
+	dsi_generic_write_seq(dsi, 0x78, 0x00);
+	dsi_generic_write_seq(dsi, 0xff, 0x24);
+	dsi_generic_write_seq(dsi, 0xfb, 0x01);
+	dsi_generic_write_seq(dsi, 0xc2, 0x80);
+	dsi_generic_write_seq(dsi, 0x68, 0xc3);
+	dsi_generic_write_seq(dsi, 0x78, 0x80);
+	dsi_generic_write_seq(dsi, 0xff, 0x26);
+	dsi_generic_write_seq(dsi, 0xfb, 0x01);
+	dsi_generic_write_seq(dsi, 0x1c, 0xfa);
+	dsi_generic_write_seq(dsi, 0xff, 0xe0);
+	dsi_generic_write_seq(dsi, 0xfb, 0x01);
+	dsi_generic_write_seq(dsi, 0x17, 0x40);
+	dsi_generic_write_seq(dsi, 0xff, 0x25);
+	dsi_generic_write_seq(dsi, 0xfb, 0x01);
+	dsi_generic_write_seq(dsi, 0x17, 0x9f);
+	dsi_generic_write_seq(dsi, 0xff, 0x10);
+	dsi_generic_write_seq(dsi, 0x51, 0xff);
+	dsi_generic_write_seq(dsi, 0x53, 0x2c);
+	dsi_generic_write_seq(dsi, 0x55, 0x82);
+	dsi_generic_write_seq(dsi, 0x11, 0x00);
+	msleep(128);
+	dsi_generic_write_seq(dsi, 0x29, 0x00);
+	msleep(32);
