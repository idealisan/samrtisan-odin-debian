[Unit]
Description=Set up compressed RAM swap (zram)
Documentation=file:/usr/local/sbin/odin-swap.sh

# ─────────────────────────────────────────────────────────────────────────
# ⚠️ 之前这个 unit **一次都没跑起来过**，原因是 systemd 依赖环：
#
#   systemd[1]: sysinit.target: Found ordering cycle on odin-swap.service/start
#   systemd[1]: sysinit.target: Job odin-swap.service/start deleted to break
#                               ordering cycle starting with sysinit.target/start
#
# 环是这样形成的（当时的写法）：
#     After=local-fs.target odin-firstboot-resize.service
#     Before=sysinit.target
#     WantedBy=sysinit.target
#   而 odin-firstboot-resize.service 是 WantedBy=multi-user.target。
#   于是：sysinit.target → odin-swap → firstboot-resize → multi-user.target
#         → sysinit.target   闭成一个环。systemd 的破环手段是**把本 unit 整个丢掉**，
#   于是 swap 从来没建过，journal 里 0 条记录 —— 表面上只是"swap 没起来"，
#   实际是 unit 被 systemd 静默丢弃了。
#
# 现在改用 zram，它不碰磁盘，**不需要等 resize2fs**，所以不再依赖
# odin-firstboot-resize.service —— 环从根上消失。
#
# 教训：`WantedBy=sysinit.target` + `Before=sysinit.target` 的单元，
# 千万别 After 一个属于 multi-user.target 的单元。改完用
#   journalctl -u <unit>   确认**有**记录才算真的跑过。
# ─────────────────────────────────────────────────────────────────────────

# zram 只需要内核模块和 sysfs，不依赖文件系统，可以很早起来。
DefaultDependencies=no
Before=swap.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/odin-swap.sh start
ExecStop=/usr/local/sbin/odin-swap.sh stop

[Install]
WantedBy=swap.target
