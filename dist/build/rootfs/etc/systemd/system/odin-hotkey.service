[Unit]
Description=ODIN 热键守护进程（电源键 = 开关屏幕）
Documentation=file:///etc/triggerhappy/triggers.d/odin-screen.conf
After=systemd-udev-settle.service

# core / gui 变体没有装 triggerhappy，这个 unit 排进启动只会是一条 failed。
# ConditionPathExists 让它在那种情况下安静跳过（status 显示 condition failed，不红）。
ConditionPathExists=/usr/sbin/thd

[Service]
Type=simple
# 刻意**自带** unit 而不用发行版那个 triggerhappy.service：
# Debian 默认以 `--user nobody` 跑，命令也就以 nobody 身份执行 —— 写不了
# /sys/class/graphics/fb0/blank，也跑不了 systemctl。这里显式 --user root。
#
# --deviceglob 只吃 event*，不吃 /dev/input/mice 之类（thd 打开鼠标类设备会
# 抢走事件，实测表现为键盘没反应）。
# --triggers 必须给**具体文件**，不能给目录。
#   实测（真机，triggerhappy 0.5.0-1.1+b2）：传目录
#   /etc/triggerhappy/triggers.d/ 时一条触发器都不执行，journal 里只有
#   "Device /dev/input/event0 not suitable."，按键完全没反应；
#   改成传 /etc/triggerhappy/triggers.d/odin-screen.conf 立刻就执行了。
#   （Debian 自带的 triggerhappy.service 传的是目录，但它被我们 mask 了。）
# --ignore KEY_VOLUMEDOWN 是**临时措施**，等 DTS 修好映射就可以去掉。
#   为什么需要：DTS 里 &pm8953_resin 被错误地 enable 并映射成 KEY_VOLUMEDOWN，
#   而原厂明确把 RESIN 设成 status="disable"（音量- 其实是 GPIO86）。
#   后果是**按一次电源键会同时冒出 KEY_POWER 和 KEY_VOLUMEDOWN**，thd 一看到
#   两个键同时按下就匹配不上单键触发器 KEY_POWER 1 —— 表现就是"按了没反应"。
#   详见 reports/002 与 WORKLOG 2026-09-07。
ExecStart=/usr/sbin/thd --triggers /etc/triggerhappy/triggers.d/odin-screen.conf \
                        --ignore KEY_VOLUMEDOWN \
                        --user root --deviceglob /dev/input/event*
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
