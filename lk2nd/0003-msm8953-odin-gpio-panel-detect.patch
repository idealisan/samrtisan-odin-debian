From: Smartisan ODIN mainline porting effort
[PATCH 3/3] msm8953: ODIN panel auto-detect via TLMM straps + fastboot oem panel

Panel selection on ODIN is done by reading two TLMM input straps
(reverse engineered from stock emmc_appsboot.mbn, see evidence/lk-re):
  GPIO91=1 GPIO92=1 -> nt36672_1080p_video
  GPIO91=1 GPIO92=0 -> ft8716_1080p_video
  GPIO91=0          -> sharp_ft8716_1080p_video (stock default)
Replicate for HW_PLATFORM_QRD + subtype 1 (board-id <11 1>).
r69006_* reachable only via explicit name override.

Also add fastboot oem panel <name>: validate against supp_panels and
immediately re-init display with the chosen panel (live switch, works
over USB even when screen is dark; not persisted across reboots).
---
--- a/target/msm8953/oem_panel.c
+++ b/target/msm8953/oem_panel.c
@@ -37,6 +37,9 @@
 #include <mipi_dsi.h>
 #include <mdp5.h>
 #include <target/display.h>
+#include <platform/gpio.h>
+#include <fastboot.h>
+#include <target.h>
 
 #include "gcdb_display.h"
 #include "include/panel.h"
@@ -430,6 +433,41 @@
 {
 	return target_panel_auto_detect_enabled() ?
 		DISPLAY_MAX_PANEL_DETECTION : 0;
+}
+
+/*
+ * Smartisan ODIN panel detection.
+ *
+ * Reverse engineering of the stock ODIN bootloader (emmc_appsboot.mbn)
+ * showed that panel selection is done by reading two TLMM input straps,
+ * not by DSI read-id (all stock mipi->signature values are 0xFFFF):
+ *
+ *	GPIO91=1, GPIO92=1 -> nt36672_1080p_video
+ *	GPIO91=1, GPIO92=0 -> ft8716_1080p_video
+ *	GPIO91=0           -> sharp_ft8716_1080p_video (stock default)
+ *
+ * The r69006_* panels are not part of the strap logic and remain
+ * selectable only through an explicit panel name override.
+ */
+static void odin_detect_panel(void)
+{
+	uint32_t g91, g92;
+
+	gpio_tlmm_config(91, 0, GPIO_INPUT, GPIO_NO_PULL, GPIO_2MA,
+			 GPIO_ENABLE);
+	gpio_tlmm_config(92, 0, GPIO_INPUT, GPIO_NO_PULL, GPIO_2MA,
+			 GPIO_ENABLE);
+	g91 = gpio_status(91);
+	g92 = gpio_status(92);
+
+	dprintf(INFO, "odin: panel straps g91=%u g92=%u\n", g91, g92);
+
+	if (g91 && g92)
+		panel_id = NT36672_1080P_VIDEO_PANEL;
+	else if (g91)
+		panel_id = FT8716_1080P_VIDEO_PANEL;
+	else
+		panel_id = SHARP_FT8716_1080P_VIDEO_PANEL;
 }
 
 int oem_panel_select(const char *panel_name, struct panel_struct *panelstruct,
@@ -471,6 +509,12 @@
 			 panel_id = HX8399C_FHD_PLUSE_VIDEO_PANEL;
 		break;
 	case HW_PLATFORM_QRD:
+		if (platform_subtype == 0x01) {
+			/* Smartisan ODIN: detect panel from TLMM straps,
+			 * same as the stock bootloader. */
+			odin_detect_panel();
+			break;
+		}
 		panel_id = R69006_1080P_CMD_PANEL;
 		if (platform_subtype == 0x01 || platform_subtype == 0x03)
 			panel_id = HX8399C_FHD_PLUSE_VIDEO_PANEL;
@@ -489,3 +533,57 @@
 	pinfo->pipe_type = MDSS_MDP_PIPE_TYPE_RGB;
 	return init_panel_data(panelstruct, pinfo, phy_db);
 }
+
+/*
+ * fastboot oem panel <name>
+ *
+ * Validate a panel name against supp_panels and immediately re-initialise
+ * the display with it. Useful for batches that cannot be identified by
+ * the straps (r69006_*) or when the strap result is inconclusive: the
+ * screen lights up immediately if the chosen panel matches, even if it
+ * was dark before. The override is not persisted across reboots.
+ */
+static void cmd_oem_panel(const char *arg, void *data, unsigned sz)
+{
+	int32_t id;
+
+	if (!arg || !*arg) {
+		fastboot_fail("usage: fastboot oem panel <name>");
+		return;
+	}
+
+	id = panel_name_to_id(supp_panels, ARRAY_SIZE(supp_panels), arg);
+	if (id < 0 || id >= UNKNOWN_PANEL) {
+		fastboot_fail("unsupported panel");
+		return;
+	}
+
+	dprintf(INFO, "oem panel: switching to %s\n", arg);
+	target_display_shutdown();
+	target_display_init(arg);
+
+	fastboot_okay("");
+}
+
+/*
+ * 注册必须用 FASTBOOT_REGISTER，不能用 FASTBOOT_INIT。
+ *
+ * FASTBOOT_INIT 的宏体是
+ *     static void (*_fastboot_init_##func)(void) __SECTION(".fastboot_init") = (func)
+ * 也就是把这个函数指针当成 **void (*)(void)** 存进 .fastboot_init 段；
+ * 而该段的消费者是（app/aboot/fastboot.h:65）
+ *     for (func = &__fastboot_init_start; func < &__fastboot_init_end; ++func)
+ *             (*func)();
+ * 按 **不传参数** 的方式调用。
+ *
+ * cmd_oem_panel 的原型是 void (*)(const char *, void *, unsigned)，
+ * 与 void (*)(void) 不兼容（GCC 会警告 "initialization of 'void (*)(void)'
+ * from incompatible pointer type"，GCC 14+ 直接当错误）。类型不匹配的后果是：
+ * 跳进去时 r0/r1/r2 没有被设置，函数却去读 arg/data/sz —— 读到的是垃圾，
+ * 于是在 aboot_fastboot_register_commands() 里就崩了。
+ *
+ * FASTBOOT_REGISTER(prefix, handlefunc) 会生成一个 void (*)(void) 的包装函数
+ * 再交给 FASTBOOT_INIT，类型就对了。上游所有 oem 命令（oem ramoops / oem hash）
+ * 用的都是它。
+ */
+FASTBOOT_REGISTER("oem panel", cmd_oem_panel);
