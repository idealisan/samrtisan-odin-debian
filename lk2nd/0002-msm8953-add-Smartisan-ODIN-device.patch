From: Smartisan ODIN mainline porting effort
Subject: [PATCH 2/4] msm8953: add Smartisan ODIN (U2 Pro) device

Map the five stock panel names to their mainline kernel compatibles so lk2nd
replaces the placeholder compatible in the Linux device tree with the detected
panel.

Generated against lk2nd 23.1. 注意：设备表格式在不同 release 间会变，换版本要重新生成本补丁（实测 21.0 上会冲突）。

diff --git a/lk2nd/device/dts/msm8953/msm8953-smartisan-odin.dts b/lk2nd/device/dts/msm8953/msm8953-smartisan-odin.dts
new file mode 100644
index 0000000..690abb3
--- /dev/null
+++ b/lk2nd/device/dts/msm8953/msm8953-smartisan-odin.dts
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+/dts-v1/;
+
+#include <skeleton64.dtsi>
+#include <lk2nd.dtsi>
+
+/ {
+	qcom,msm-id = <QCOM_ID_MSM8953 0>;
+	qcom,board-id = <0x0b 0x01>;
+};
+
+&lk2nd {
+	model = "Smartisan U2 Pro (ODIN)";
+	compatible = "smartisan,odin";
+
+	lk2nd,dtb-files = "msm8953-smartisan-odin";
+
+	panel {
+		compatible = "smartisan,odin-panel", "lk2nd,panel";
+
+		qcom,mdss_dsi_r69006_1080p_cmd {
+			compatible = "smartisan,odin-r69006-cmd";
+		};
+		qcom,mdss_dsi_r69006_1080p_video {
+			compatible = "smartisan,odin-r69006-video";
+		};
+		qcom,mdss_dsi_ft8716_1080p_video {
+			compatible = "smartisan,odin-ft8716";
+		};
+		qcom,mdss_dsi_nt36672_1080p_video {
+			compatible = "smartisan,odin-nt36672";
+		};
+		qcom,mdss_dsi_sharp_ft8716_1080p_video {
+			compatible = "smartisan,odin-sharp-ft8716";
+		};
+	};
+};
diff --git a/lk2nd/device/dts/msm8953/rules.mk b/lk2nd/device/dts/msm8953/rules.mk
--- a/lk2nd/device/dts/msm8953/rules.mk
+++ b/lk2nd/device/dts/msm8953/rules.mk
@@ -12,7 +12,8 @@ ADTBS += \
 	$(LOCAL_DIR)/msm8953-motorola-sanders.dtb \
 	$(LOCAL_DIR)/msm8953-mtp.dtb \
 	$(LOCAL_DIR)/msm8953-oppo-r9s.dtb \
 	$(LOCAL_DIR)/msm8953-qrd.dtb \
+	$(LOCAL_DIR)/msm8953-smartisan-odin.dtb \
 	$(LOCAL_DIR)/msm8953-xiaomi-common.dtb \
 	$(LOCAL_DIR)/msm8953-xiaomi-daisy.dtb \
 	$(LOCAL_DIR)/msm8953-xiaomi-markw.dtb \
