-	{
 		boot_linux_from_flash();
-	}
 }
 
 void cmd_reboot(const char *arg, void *data, unsigned sz)
@@ -5655,6 +5672,18 @@ normal_boot:
 #if WITH_LK2ND_BOOT
 		if (!boot_into_recovery)
 			lk2nd_boot();
+
+		/*
+		 * lk2nd 没能从任何文件系统引导起来时会置 boot_into_fastboot
