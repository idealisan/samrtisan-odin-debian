@@ -4672,13 +4673,29 @@ void cmd_continue(const char *arg, void *data, unsigned sz)
 #if WITH_LK2ND_BOOT
 		if (!boot_into_recovery)
 			lk2nd_boot();
+
+		/*
+		 * lk2nd 没能从任何文件系统引导起来时会置 boot_into_fastboot
+		 * （见 lk2nd/boot/boot.c 的 lk2nd_scan_devices()）。这里直接返回：
+		 * fastboot 主循环还在跑，菜单会重新画一遍。
