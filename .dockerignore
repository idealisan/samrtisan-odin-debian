# 构建上下文里不要的东西。规则：只让"编译需要的源码与脚本"进上下文，
# 任何一次构建产生的中间物、以及真机取证数据都不该参与镜像构建。

# 版本库本身：镜像里不需要 .git，构建时会重新挂载仓库
.git

# 构建输出与临时工作区（AGENTS.md §1.6）
out/
tmp/

# 编译产物：一律不入库，也不进镜像
*.img
*.dtb
*.ko
*.tar
*.tar.gz
*.cpio.gz
*.bin
*.elf
*.mbn

# QEMU 回归台的内核与测试盘
odin-qemu/Image
odin-qemu/*.img

# 真机取证数据（体积大，且与编译无关）
evidence/

# 工具私有状态
.codebuddy/
.DS_Store
